  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Signed instantaneous power at a battery system, positive while charging and negative while discharging."
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#ChargedEnergy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "charged energy"
