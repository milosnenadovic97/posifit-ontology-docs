  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://saref.etsi.org/core/Property"
  }, {
    "@id" : "_:genid13"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Cumulative electrical energy a battery system has taken in."
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#ConsumptionMeter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "consumption meter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://saref.etsi.org/core/Device"
  }, {
    "@id" : "https://saref.etsi.org/core/FeatureOfInterest"
  }, {
    "@id" : "https://saref.etsi.org/core/Meter"
  }, {
    "@id" : "_:genid14"
  }, {
    "@id" : "_:genid15"
  }, {
