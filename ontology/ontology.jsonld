}, {
  "@id" : "https://w3id.org/posifit",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "en",
    "@value" : "A vocabulary for describing positive-energy building retrofits: the spatial breakdown of a pilot site and the sensing equipment, measurement points and timeseries references attached to it."
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@language" : "en",
    "@value" : "PosiFit consortium"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "The PosiFit ontology is intended to describe positive-energy building retrofit projects. It is designed around the reuse and alignment of established domain ontologies. BOT is used for spatial structure, SAREF for devices and measurements, Brick for point roles and timeseries references, QUDT for units, and vCard and WGS84 for addresses and coordinates. Terms are introduced in the pf: namespace only where PosiFit requires concepts that are not covered by these existing vocabularies. This documentation therefore focuses on the PosiFit-specific classes and properties, together with the alignments that connect them to the ontologies they reuse."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@language" : "en",
    "@value" : "PosiFit"
  } ],
  "http://purl.org/dc/terms/rights" : [ {
    "@language" : "en",
    "@value" : "© PosiFit consortium — licensed under CC BY 4.0."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "PosiFit ontology"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "0.1.0"
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#ActiveEnergy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "active energy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://saref.etsi.org/core/Property"
  }, {
    "@id" : "_:genid4"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Cumulative electrical energy consumed by a monitored unit."
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#ActivePower",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "active power"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://saref.etsi.org/core/Property"
  }, {
    "@id" : "_:genid5"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Instantaneous electrical power drawn by a monitored unit."
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#Apartment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A genuinely new concept, not equivalent to either parent: narrower than bot:Space and brick:Space, which both cover single rooms too. Containment uses the BOT topology properties (bot:hasStorey, bot:hasSpace) rather than PosiFit-minted equivalents."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "apartment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://brickschema.org/schema/Brick#Space"
  }, {
    "@id" : "https://w3id.org/bot#Space"
  }, {
    "@id" : "https://w3id.org/bot#Zone"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Self-contained dwelling unit on a floor, treated as the smallest billable and separately monitored space."
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#ApparentPower",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "apparent power"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://saref.etsi.org/core/Property"
  }, {
    "@id" : "_:genid6"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Product of RMS voltage and RMS current at the metering point, the vector sum of active and reactive power."
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#BatteryLevel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "battery level"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://saref.etsi.org/core/Property"
  }, {
    "@id" : "_:genid7"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Remaining charge of a device's battery as a fraction of its capacity."
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#BatteryStorageSystem",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Not a pf:Sensor or saref:Device: Brick models storage as a system — a collection of equipment — and the streams hang off the installation, not off a cell. bot:Element is what places it inside a building; saref:FeatureOfInterest is what lets it carry its nameplate rating as a saref:hasProperty, that property's domain."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "battery storage system"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://brickschema.org/schema/Brick#Battery_Energy_Storage_System"
  }, {
    "@id" : "https://brickschema.org/schema/Brick#Class"
  }, {
    "@id" : "https://brickschema.org/schema/Brick#Collection"
  }, {
    "@id" : "https://brickschema.org/schema/Brick#Electrical_System"
  }, {
    "@id" : "https://brickschema.org/schema/Brick#Energy_Storage_System"
  }, {
    "@id" : "https://brickschema.org/schema/Brick#Energy_System"
  }, {
    "@id" : "https://brickschema.org/schema/Brick#Entity"
  }, {
    "@id" : "https://brickschema.org/schema/Brick#System"
  }, {
    "@id" : "https://saref.etsi.org/core/FeatureOfInterest"
  }, {
    "@id" : "https://w3id.org/bot#Element"
  }, {
    "@id" : "_:genid8"
  }, {
    "@id" : "_:genid9"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Electrochemical storage installation serving a building, charging from the supply or from on-site generation and discharging back into it, metered and reported as one installation rather than cell by cell."
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#Building",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Narrower than bot:Building, not equivalent: spatial.axioms.ttl requires a postal address, which BOT leaves optional. The equivalence it carried until then would have propagated that requirement to every bot:Building."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "building"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/bot#Building"
  }, {
    "@id" : "https://w3id.org/bot#Zone"
  }, {
    "@id" : "_:genid10"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "https://brickschema.org/schema/Brick#Building"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Independent structure with a roof and walls, hosting the dwellings and systems PosiFit monitors."
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#CO2Concentration",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CO2 concentration"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://saref.etsi.org/core/Property"
  }, {
    "@id" : "_:genid11"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Concentration of carbon dioxide in the air of a monitored space."
  } ]
}, {
  "@id" : "https://w3id.org/posifit/pf#ChargeDischargePower",
