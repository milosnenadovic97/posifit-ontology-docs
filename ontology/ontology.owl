<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/posifit#"
     xml:base="https://w3id.org/posifit"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/posifit">
        <terms:abstract xml:lang="en">A vocabulary for describing positive-energy building retrofits: the spatial breakdown of a pilot site and the sensing equipment, measurement points and timeseries references attached to it.</terms:abstract>
        <terms:creator xml:lang="en">PosiFit consortium</terms:creator>
        <terms:description xml:lang="en">The PosiFit ontology is intended to describe positive-energy building retrofit projects. It is designed around the reuse and alignment of established domain ontologies. BOT is used for spatial structure, SAREF for devices and measurements, Brick for point roles and timeseries references, QUDT for units, and vCard and WGS84 for addresses and coordinates. Terms are introduced in the pf: namespace only where PosiFit requires concepts that are not covered by these existing vocabularies. This documentation therefore focuses on the PosiFit-specific classes and properties, together with the alignments that connect them to the ontologies they reuse.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher xml:lang="en">PosiFit</terms:publisher>
        <terms:rights xml:lang="en">© PosiFit consortium — licensed under CC BY 4.0.</terms:rights>
        <rdfs:label xml:lang="en">PosiFit ontology</rdfs:label>
        <owl:versionInfo>0.1.0</owl:versionInfo>
    </owl:Ontology>
    


