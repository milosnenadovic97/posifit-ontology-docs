    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2006/vcard/ns#hasAddress -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/vcard/ns#hasAddress"/>
    


    <!-- https://brickschema.org/schema/Brick#hasPoint -->


    <owl:ObjectProperty rdf:about="https://brickschema.org/schema/Brick#hasPoint"/>
    


    <!-- https://brickschema.org/schema/Brick/ref#hasTimeseriesReference -->


    <owl:ObjectProperty rdf:about="https://brickschema.org/schema/Brick/ref#hasTimeseriesReference"/>
    


    <!-- https://saref.etsi.org/core/controls -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/controls"/>
    


    <!-- https://saref.etsi.org/core/hasProperty -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/hasProperty"/>
    


    <!-- https://saref.etsi.org/core/isMeasuredIn -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/isMeasuredIn"/>
    


    <!-- https://saref.etsi.org/core/observes -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/observes"/>
    


    <!-- https://w3id.org/bot#hasZeroPoint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/bot#hasZeroPoint"/>
    


    <!-- https://w3id.org/posifit/pf#measures -->


    <owl:ObjectProperty rdf:about="https://w3id.org/posifit/pf#measures">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/observes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/posifit/pf#MeasurementPoint"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://saref.etsi.org/core/Property"/>
                    <rdf:Description rdf:about="https://saref.etsi.org/core/State"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">measures</rdfs:label>
        <skos:definition xml:lang="en">Links a measurement point to the quantity its stream carries.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/posifit/pf#billingPeriod -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/posifit/pf#billingPeriod">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/posifit/pf#MeasurementPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">billing period</rdfs:label>
        <skos:definition xml:lang="en">Billing period a measurement point&apos;s count covers, relative to the present.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/posifit/pf#hasPilotCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/posifit/pf#hasPilotCode">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/posifit/pf#Site"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has pilot code</rdfs:label>
        <skos:definition xml:lang="en">Short code identifying a site.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/posifit/pf#hasTenantCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/posifit/pf#hasTenantCode">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/posifit/pf#TenantSpace"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has tenant code</rdfs:label>
        <skos:definition xml:lang="en">Code identifying a tenant space within its site.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/posifit/pf#ratedEnergyCapacity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/posifit/pf#ratedEnergyCapacity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/posifit/pf#BatteryStorageSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">rated energy capacity</rdfs:label>
        <skos:definition xml:lang="en">Nameplate energy capacity of a storage system, in kilowatt-hours.</skos:definition>
    </owl:DatatypeProperty>
    


