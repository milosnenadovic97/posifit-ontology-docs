                                          rdfs:subClassOf <https://brickschema.org/schema/Brick#Space> ,
                                                          <https://w3id.org/bot#Space> ,
                                                          <https://w3id.org/bot#Zone> ;
                                          rdfs:label "tenant space"@en ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "A space held under a single tenancy."@en .


###  https://w3id.org/posifit/pf#ValvePosition
<https://w3id.org/posifit/pf#ValvePosition> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                              owl:hasValue <http://qudt.org/vocab/unit/PERCENT>
                                                            ] ;
                                            rdfs:label "valve position"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Degree to which a valve stands open, from fully closed to fully open."@en .


###  https://w3id.org/posifit/pf#Voltage
<https://w3id.org/posifit/pf#Voltage> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                        owl:hasValue <http://qudt.org/vocab/unit/V>
                                                      ] ;
                                      rdfs:label "voltage"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Electric potential difference at a metering point."@en .


###  https://w3id.org/posifit/pf#WeatherStation
