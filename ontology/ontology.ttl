@prefix : <https://w3id.org/posifit#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/posifit#> .

<https://w3id.org/posifit> rdf:type owl:Ontology ;
                            <http://purl.org/dc/terms/abstract> "A vocabulary for describing positive-energy building retrofits. It covers the spatial breakdown of a monitored site and the sensing equipment, measurement points and timeseries references attached to it."@en ;
                            <http://purl.org/dc/terms/creator> "PosiFit consortium"@en ;
                            <http://purl.org/dc/terms/description> "The PosiFit ontology is intended to describe positive-energy building retrofit projects. It is designed around the reuse and alignment of established domain ontologies. BOT is used for spatial structure, SAREF for devices and measurements, Brick for point roles and timeseries references, QUDT for units, and vCard and WGS84 for addresses and coordinates. Terms are introduced in the pf: namespace only where a concept is not covered by these existing vocabularies. This documentation therefore focuses on the PosiFit-specific classes and properties, together with the alignments that connect them to the ontologies they reuse."@en ;
                            <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                            <http://purl.org/dc/terms/publisher> "PosiFit"@en ;
                            <http://purl.org/dc/terms/rights> "© PosiFit consortium. Licensed under CC BY 4.0."@en ;
                            rdfs:label "PosiFit ontology"@en ;
                            owl:versionInfo "0.1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/rights
<http://purl.org/dc/terms/rights> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2006/vcard/ns#hasAddress
<http://www.w3.org/2006/vcard/ns#hasAddress> rdf:type owl:ObjectProperty .


###  https://brickschema.org/schema/Brick#hasPoint
<https://brickschema.org/schema/Brick#hasPoint> rdf:type owl:ObjectProperty .


###  https://brickschema.org/schema/Brick/ref#hasTimeseriesReference
<https://brickschema.org/schema/Brick/ref#hasTimeseriesReference> rdf:type owl:ObjectProperty .


###  https://saref.etsi.org/core/controls
<https://saref.etsi.org/core/controls> rdf:type owl:ObjectProperty .


###  https://saref.etsi.org/core/hasProperty
<https://saref.etsi.org/core/hasProperty> rdf:type owl:ObjectProperty .


###  https://saref.etsi.org/core/isMeasuredIn
<https://saref.etsi.org/core/isMeasuredIn> rdf:type owl:ObjectProperty .


###  https://saref.etsi.org/core/observes
<https://saref.etsi.org/core/observes> rdf:type owl:ObjectProperty .


###  https://w3id.org/bot#hasZeroPoint
<https://w3id.org/bot#hasZeroPoint> rdf:type owl:ObjectProperty .


###  https://w3id.org/posifit/pf#measures
<https://w3id.org/posifit/pf#measures> rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf <https://saref.etsi.org/core/observes> ;
                                       rdf:type owl:FunctionalProperty ;
                                       rdfs:domain <https://w3id.org/posifit/pf#MeasurementPoint> ;
                                       rdfs:range [ rdf:type owl:Class ;
                                                    owl:unionOf ( <https://saref.etsi.org/core/Property>
                                                                  <https://saref.etsi.org/core/State>
                                                                )
                                                  ] ;
                                       rdfs:label "measures"@en ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Links a measurement point to the quantity its stream carries."@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/posifit/pf#billingPeriod
<https://w3id.org/posifit/pf#billingPeriod> rdf:type owl:DatatypeProperty ,
                                                     owl:FunctionalProperty ;
                                            rdfs:domain <https://w3id.org/posifit/pf#MeasurementPoint> ;
                                            rdfs:range xsd:string ;
                                            rdfs:label "billing period"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Billing period a measurement point's count covers, relative to the present."@en .


###  https://w3id.org/posifit/pf#hasPilotCode
<https://w3id.org/posifit/pf#hasPilotCode> rdf:type owl:DatatypeProperty ,
                                                    owl:FunctionalProperty ;
                                           rdfs:domain <https://w3id.org/posifit/pf#Site> ;
                                           rdfs:range xsd:string ;
                                           rdfs:label "has pilot code"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "Short code identifying a site."@en .


###  https://w3id.org/posifit/pf#hasTenantCode
<https://w3id.org/posifit/pf#hasTenantCode> rdf:type owl:DatatypeProperty ,
                                                     owl:FunctionalProperty ;
                                            rdfs:domain <https://w3id.org/posifit/pf#TenantSpace> ;
                                            rdfs:range xsd:string ;
                                            rdfs:label "has tenant code"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Code identifying a tenant space within its site."@en .


###  https://w3id.org/posifit/pf#ratedEnergyCapacity
<https://w3id.org/posifit/pf#ratedEnergyCapacity> rdf:type owl:DatatypeProperty ,
                                                           owl:FunctionalProperty ;
                                                  rdfs:domain <https://w3id.org/posifit/pf#BatteryStorageSystem> ;
                                                  rdfs:range xsd:decimal ;
                                                  rdfs:label "rated energy capacity"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "Nameplate energy capacity of a storage system, in kilowatt-hours."@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2003/01/geo/wgs84_pos#Point
<http://www.w3.org/2003/01/geo/wgs84_pos#Point> rdf:type owl:Class .


###  http://www.w3.org/2006/vcard/ns#Address
<http://www.w3.org/2006/vcard/ns#Address> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Battery_Energy_Storage_System
<https://brickschema.org/schema/Brick#Battery_Energy_Storage_System> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Class
<https://brickschema.org/schema/Brick#Class> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Collection
<https://brickschema.org/schema/Brick#Collection> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Electrical_Equipment
<https://brickschema.org/schema/Brick#Electrical_Equipment> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Electrical_System
<https://brickschema.org/schema/Brick#Electrical_System> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Energy_Generation_System
<https://brickschema.org/schema/Brick#Energy_Generation_System> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Energy_Storage_System
<https://brickschema.org/schema/Brick#Energy_Storage_System> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Energy_System
<https://brickschema.org/schema/Brick#Energy_System> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Entity
<https://brickschema.org/schema/Brick#Entity> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Equipment
<https://brickschema.org/schema/Brick#Equipment> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Inverter
<https://brickschema.org/schema/Brick#Inverter> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#PV_Generation_System
<https://brickschema.org/schema/Brick#PV_Generation_System> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Photovoltaic_Inverter
<https://brickschema.org/schema/Brick#Photovoltaic_Inverter> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Point
<https://brickschema.org/schema/Brick#Point> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Room
<https://brickschema.org/schema/Brick#Room> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#Space
<https://brickschema.org/schema/Brick#Space> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick#System
<https://brickschema.org/schema/Brick#System> rdf:type owl:Class .


###  https://brickschema.org/schema/Brick/ref#TimeseriesReference
<https://brickschema.org/schema/Brick/ref#TimeseriesReference> rdf:type owl:Class .


###  https://saref.etsi.org/core/Actuator
<https://saref.etsi.org/core/Actuator> rdf:type owl:Class .


###  https://saref.etsi.org/core/Device
<https://saref.etsi.org/core/Device> rdf:type owl:Class .


###  https://saref.etsi.org/core/FeatureOfInterest
<https://saref.etsi.org/core/FeatureOfInterest> rdf:type owl:Class .


###  https://saref.etsi.org/core/Meter
<https://saref.etsi.org/core/Meter> rdf:type owl:Class .


###  https://saref.etsi.org/core/Property
<https://saref.etsi.org/core/Property> rdf:type owl:Class .


###  https://saref.etsi.org/core/Sensor
<https://saref.etsi.org/core/Sensor> rdf:type owl:Class .


###  https://saref.etsi.org/core/State
<https://saref.etsi.org/core/State> rdf:type owl:Class .


###  https://w3id.org/bot#Building
<https://w3id.org/bot#Building> rdf:type owl:Class .


###  https://w3id.org/bot#Element
<https://w3id.org/bot#Element> rdf:type owl:Class .


###  https://w3id.org/bot#Site
<https://w3id.org/bot#Site> rdf:type owl:Class .


###  https://w3id.org/bot#Space
<https://w3id.org/bot#Space> rdf:type owl:Class .


###  https://w3id.org/bot#Storey
<https://w3id.org/bot#Storey> rdf:type owl:Class ;
                              owl:equivalentClass <https://w3id.org/posifit/pf#Floor> .


###  https://w3id.org/bot#Zone
<https://w3id.org/bot#Zone> rdf:type owl:Class .


###  https://w3id.org/posifit/pf#ActiveEnergy
<https://w3id.org/posifit/pf#ActiveEnergy> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                             owl:hasValue <http://qudt.org/vocab/unit/KiloW-HR>
                                                           ] ;
                                           rdfs:label "active energy"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "Cumulative electrical energy consumed by a unit."@en .


###  https://w3id.org/posifit/pf#ActivePower
<https://w3id.org/posifit/pf#ActivePower> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                            owl:hasValue <http://qudt.org/vocab/unit/W>
                                                          ] ;
                                          rdfs:label "active power"@en ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "Instantaneous electrical power drawn by a unit."@en .


###  https://w3id.org/posifit/pf#AirTemperature
<https://w3id.org/posifit/pf#AirTemperature> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                               owl:hasValue <http://qudt.org/vocab/unit/DEG_C>
                                                             ] ;
                                             rdfs:label "air temperature"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Dry-bulb temperature of air."@en .


###  https://w3id.org/posifit/pf#Apartment
<https://w3id.org/posifit/pf#Apartment> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/posifit/pf#TenantSpace> ;
                                        rdfs:label "apartment"@en ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "A self-contained dwelling unit on a floor, billed and monitored separately."@en .


###  https://w3id.org/posifit/pf#ApparentPower
<https://w3id.org/posifit/pf#ApparentPower> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                              owl:hasValue <http://qudt.org/vocab/unit/V-A>
                                                            ] ;
                                            rdfs:label "apparent power"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Product of RMS voltage and RMS current at a metering point, the vector sum of active and reactive power."@en .


###  https://w3id.org/posifit/pf#Bathroom
<https://w3id.org/posifit/pf#Bathroom> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/bot#Space> ,
                                                       <https://w3id.org/bot#Zone> ,
                                                       <https://w3id.org/posifit/pf#Room> ;
                                       rdfs:label "bathroom"@en ;
                                       <http://www.w3.org/2004/02/skos/core#closeMatch> <https://brickschema.org/schema/Brick#Restroom> ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "A room of a dwelling containing a bath or shower, and usually a washbasin and a toilet."@en .


###  https://w3id.org/posifit/pf#BatteryLevel
<https://w3id.org/posifit/pf#BatteryLevel> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                             owl:hasValue <http://qudt.org/vocab/unit/PERCENT>
                                                           ] ;
                                           rdfs:label "battery level"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "Remaining charge of a device's battery as a fraction of its capacity."@en .


###  https://w3id.org/posifit/pf#BatteryStorageSystem
<https://w3id.org/posifit/pf#BatteryStorageSystem> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://brickschema.org/schema/Brick#Battery_Energy_Storage_System> ,
                                                                   <https://brickschema.org/schema/Brick#Class> ,
                                                                   <https://brickschema.org/schema/Brick#Collection> ,
                                                                   <https://brickschema.org/schema/Brick#Electrical_System> ,
                                                                   <https://brickschema.org/schema/Brick#Energy_Storage_System> ,
                                                                   <https://brickschema.org/schema/Brick#Energy_System> ,
                                                                   <https://brickschema.org/schema/Brick#Entity> ,
                                                                   <https://brickschema.org/schema/Brick#System> ,
                                                                   <https://saref.etsi.org/core/FeatureOfInterest> ,
                                                                   <https://w3id.org/bot#Element> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://brickschema.org/schema/Brick#hasPoint> ;
                                                                     owl:someValuesFrom <https://w3id.org/posifit/pf#MeasurementPoint>
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://saref.etsi.org/core/hasProperty> ;
                                                                     owl:someValuesFrom <https://w3id.org/posifit/pf#RatedEnergyCapacity>
                                                                   ] ;
                                                   rdfs:label "battery storage system"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "An electrochemical storage installation serving a building, charging from the supply or from on-site generation and discharging back into it."@en .


###  https://w3id.org/posifit/pf#Building
<https://w3id.org/posifit/pf#Building> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/bot#Building> ,
                                                       <https://w3id.org/bot#Zone> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://www.w3.org/2006/vcard/ns#hasAddress> ;
                                                         owl:someValuesFrom <http://www.w3.org/2006/vcard/ns#Address>
                                                       ] ;
                                       rdfs:label "building"@en ;
                                       <http://www.w3.org/2004/02/skos/core#closeMatch> <https://brickschema.org/schema/Brick#Building> ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "An independent structure with a roof and walls, containing dwellings and building systems."@en .


###  https://w3id.org/posifit/pf#CO2Concentration
<https://w3id.org/posifit/pf#CO2Concentration> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                                 owl:hasValue <http://qudt.org/vocab/unit/PPM>
                                                               ] ;
                                               rdfs:label "CO2 concentration"@en ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Concentration of carbon dioxide in the air of a space."@en .


###  https://w3id.org/posifit/pf#ChargeDischargePower
<https://w3id.org/posifit/pf#ChargeDischargePower> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                                     owl:hasValue <http://qudt.org/vocab/unit/W>
                                                                   ] ;
                                                   rdfs:label "charge/discharge power"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "Signed instantaneous power at a battery system, positive while charging and negative while discharging."@en .


###  https://w3id.org/posifit/pf#ChargedEnergy
<https://w3id.org/posifit/pf#ChargedEnergy> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                              owl:hasValue <http://qudt.org/vocab/unit/KiloW-HR>
                                                            ] ;
                                            rdfs:label "charged energy"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Cumulative electrical energy a battery system has taken in."@en .


###  https://w3id.org/posifit/pf#ConsumptionMeter
<https://w3id.org/posifit/pf#ConsumptionMeter> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://saref.etsi.org/core/Device> ,
                                                               <https://saref.etsi.org/core/FeatureOfInterest> ,
                                                               <https://saref.etsi.org/core/Meter> ,
                                                               <https://w3id.org/bot#Element> ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://brickschema.org/schema/Brick#hasPoint> ;
                                                                 owl:someValuesFrom <https://w3id.org/posifit/pf#MeasurementPoint>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://saref.etsi.org/core/observes> ;
                                                                 owl:someValuesFrom <https://w3id.org/posifit/pf#ActiveEnergy>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://saref.etsi.org/core/observes> ;
                                                                 owl:someValuesFrom <https://w3id.org/posifit/pf#ActivePower>
                                                               ] ;
                                               rdfs:label "consumption meter"@en ;
                                               <http://www.w3.org/2004/02/skos/core#closeMatch> <https://brickschema.org/schema/Brick#Electrical_Meter> ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "An electricity meter of a dwelling unit, measuring active power and active energy."@en .


###  https://w3id.org/posifit/pf#DischargedEnergy
<https://w3id.org/posifit/pf#DischargedEnergy> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                                 owl:hasValue <http://qudt.org/vocab/unit/KiloW-HR>
                                                               ] ;
                                               rdfs:label "discharged energy"@en ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Cumulative electrical energy a battery system has given back."@en .


###  https://w3id.org/posifit/pf#DormRoom
<https://w3id.org/posifit/pf#DormRoom> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/posifit/pf#TenantSpace> ;
                                       rdfs:label "dorm room"@en ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "A study-bedroom in a student residence, sharing sanitary and cooking facilities with the floor."@en .


###  https://w3id.org/posifit/pf#ElectricCurrent
<https://w3id.org/posifit/pf#ElectricCurrent> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://saref.etsi.org/core/Property> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://saref.etsi.org/core/isMeasuredIn> ;
                                                                owl:hasValue <http://qudt.org/vocab/unit/A>
                                                              ] ;
                                              rdfs:label "electric current"@en ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "Electric current flowing through a metering point."@en .


###  https://w3id.org/posifit/pf#ElectricityAnalyzer
<https://w3id.org/posifit/pf#ElectricityAnalyzer> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://saref.etsi.org/core/Device> ,
                                                                  <https://saref.etsi.org/core/FeatureOfInterest> ,
                                                                  <https://saref.etsi.org/core/Meter> ,
                                                                  <https://w3id.org/bot#Element> ,
                                                                  <https://w3id.org/posifit/pf#ConsumptionMeter> ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://saref.etsi.org/core/observes> ;
                                                                    owl:someValuesFrom <https://w3id.org/posifit/pf#ApparentPower>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
