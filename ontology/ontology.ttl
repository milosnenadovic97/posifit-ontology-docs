                                                                    owl:onProperty <https://saref.etsi.org/core/observes> ;
                                                                    owl:someValuesFrom <https://w3id.org/posifit/pf#Voltage>
                                                                  ] ;
                                                  rdfs:label "electricity analyzer"@en ;
