                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://saref.etsi.org/core/observes> ;
                                                               owl:someValuesFrom <https://w3id.org/posifit/pf#OutdoorAirTemperature>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://saref.etsi.org/core/observes> ;
                                                               owl:someValuesFrom <https://w3id.org/posifit/pf#WindSpeed>
                                                             ] ;
                                             rdfs:label "weather station"@en ;
                                             <http://www.w3.org/2004/02/skos/core#closeMatch> <https://brickschema.org/schema/Brick#Weather_Station> ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "A device at a site measuring the outdoor conditions a building is exposed to."@en .


###  https://w3id.org/posifit/pf#WindSpeed
